# Only dist/extension.js (+ .map), README.md, CHANGELOG.md, LICENSE, and
# images/icon.png should end up in the packaged VSIX.
#
# NOTE: dist/ is gitignored but MUST ship in the VSIX — do not exclude it here.

.vscode/**
.vscode-test/**
.vscode-test.mjs
src/**
dist-test/**
docs/**
node_modules/**
.github/**
.claude/**

**/*.ts
**/tsconfig*.json
biome.json
bun.lock
.gitignore
.editorconfig

CONTRIBUTING.md
*.vsix

# README screenshots/hero don't need to ship — vsce rewrites relative image
# links to the GitHub raw URLs. Only the extension icon must be in the VSIX.
images/**
!images/icon.png

# macOS Finder cruft
**/.DS_Store
